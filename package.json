{
  "name": "pbo-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:changed": "node scripts/lint-changed.mjs",
    "assets:check": "node scripts/optimize-public-images.mjs --check",
    "assets:optimize": "node scripts/optimize-public-images.mjs --write",
    "changelog:validate": "node scripts/verify-changelog-release.mjs --manifest-only",
    "changelog:verify": "node scripts/verify-changelog-release.mjs",
    "db:migrate:startup": "node scripts/run-startup-migrations.mjs",
    "deploy:fly": "npm run changelog:verify && flyctl deploy --remote-only --yes",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "npx tsx src/lib/seed.ts",
    "elo:recalculate": "npx tsx src/lib/recalculate-elo.ts",
    "hax:backfill": "node scripts/backfill-season11-hax.mjs",
    "hax:check": "node --experimental-strip-types scripts/check-hax-rules.mjs",
    "speed-tiers:check": "node --experimental-strip-types scripts/check-speed-tiers.mjs",
    "bot": "npx tsx src/bot/index.ts",
    "bot:build": "node scripts/build-bot.js",
    "bot:deploy-commands": "npx tsx src/bot/deploy-commands.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@libsql/client": "^0.17.0",
    "@pkmn/dex": "^0.10.11",
    "@smogon/calc": "^0.10.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.5.0",
    "clsx": "^2.1.1",
    "discord.js": "^14.18.0",
    "drizzle-orm": "^0.45.1",
    "googleapis": "^170.1.0",
    "lucide-react": "^0.564.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.6.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.27.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "xlsx": "^0.18.5"
  }
}
