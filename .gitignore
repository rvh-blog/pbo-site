# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
**/.next/
/out/

# production
/build
/dist

# local databases and SQLite sidecars
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# local backups, exports, and generated data
/backups/
/data/
missing_pokemon_data.csv
scripts/pokeapi-cache.json

# local agent/tool state
/.tools/
/.claude/
/.secrets/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next-dev*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
