# Local database. Omit this to use the default repo-root pbo.db.
DATABASE_PATH=pbo.db

# Optional local DB query logging.
DEBUG_DB=false

# Local site URL used by bot/integration callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Admin/session secrets. Do not use these placeholder values in production.
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me

# Discord bot. Required only when running/deploying bot commands.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_DEV_GUILD_ID=
DISCORD_TOKEN=

# Pokemon Showdown auth. Required only for /api/showdown-auth.
SHOWDOWN_USERNAME=
SHOWDOWN_PASSWORD=

# Wiglett webhook verification.
WIGLETT_WEBHOOK_SECRET=

# Legacy/one-off scripts only.
USE_TURSO=false
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
